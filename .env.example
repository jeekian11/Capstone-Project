# Copy this file to .env and fill in real values. .env is gitignored so
# your real secrets never get committed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP — must be a 16-character Gmail "App Password", NOT your
# normal Gmail login password. Steps to get one:
#   1. https://myaccount.google.com/security
#   2. Turn ON "2-Step Verification" for this Gmail account (App Passwords
#      only exist once 2-Step Verification is enabled).
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new app password (name it e.g. "CompuLab"), then paste the
#      16-character code below with NO spaces.
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword

# Used to build links inside emails (e.g. the account verification link).
# Set this to the address your PHONE can actually reach — your computer's
# LAN IP + port, NOT 127.0.0.1/localhost (those only mean "this computer").
#   Windows: run `ipconfig` in cmd, look for "IPv4 Address" (e.g. 192.168.1.96)
#   Mac/Linux: run `ifconfig` or `ip addr`
# Then make sure that IP is also listed in ALLOWED_HOSTS in settings.py,
# and start the server with: python manage.py runserver 0.0.0.0:8000
SITE_URL=http://192.168.1.96:8000
